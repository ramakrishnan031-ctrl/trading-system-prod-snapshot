# --- Telegram Alerts ---
TELEGRAM_BOT_TOKEN=FILL_YOUR_BOT_TOKEN
TELEGRAM_CHANNEL_PRIMARY=FILL_CHANNEL_ID_1
TELEGRAM_CHANNEL_SECONDARY=FILL_CHANNEL_ID_2
TELEGRAM_PERSONAL_CHAT_ID=FILL_YOUR_PERSONAL_ID

# --- Webhook Security ---
# Generate ONCE: python -c "import secrets; print(secrets.token_hex(32))"
# Use SAME value in Chartink webhook config. Do NOT regenerate.
WEBHOOK_SECRET=FILL_GENERATE_ONCE_AND_KEEP
