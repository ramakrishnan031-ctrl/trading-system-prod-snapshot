# ============================================================
# Trading System v2 -- Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================
#
# Access tokens come from data_store/session/zerodha_token.json
# (regenerated daily via scripts/zerodha_login.py).
# No ACCESS_TOKEN in this file.
# ============================================================

# --- Zerodha LFL836 (Kandasamy) -- PRIMARY ---
ZERODHA_API_KEY_LFL836=FILL_YOUR_API_KEY
ZERODHA_API_SECRET_LFL836=FILL_YOUR_API_SECRET
ZERODHA_TOTP_LFL836=FILL_YOUR_TOTP_SECRET

# --- Zerodha DR6114 (Ramakrishnan) -- DISABLED ---
ZERODHA_API_KEY_DR6114=FILL_WHEN_READY
ZERODHA_API_SECRET_DR6114=FILL_WHEN_READY
ZERODHA_TOTP_DR6114=FILL_WHEN_READY

# --- Zerodha D351962 (Dhanalakshmi) -- DISABLED ---
ZERODHA_API_KEY_D351962=FILL_WHEN_READY
ZERODHA_API_SECRET_D351962=FILL_WHEN_READY
ZERODHA_TOTP_D351962=FILL_WHEN_READY

