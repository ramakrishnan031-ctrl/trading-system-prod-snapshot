# ──────────────────────────────────────────────────────────────────────────────
# Trading System v2 — Environment Variables Template
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
#
# Usage:
#   cp .env.example .env
#   # edit .env with real credentials
#   python main.py --mode paper
# ──────────────────────────────────────────────────────────────────────────────

# Zerodha credentials (account: LFL836)
# api_key:      from Kite Connect developer console (static)
# api_secret:   from Kite Connect developer console (static)
# access_token: generated daily via kite login flow (rotates every session)
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here
ZERODHA_ACCESS_TOKEN=daily_fresh_token_here

# Telegram alerts
# Bot token from @BotFather; chat/group ID from @userinfobot
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Webhook security (optional — set to a random string to enable HMAC validation)
# Leave empty to disable webhook signature checks
WEBHOOK_SECRET=optional_hmac_secret_here
