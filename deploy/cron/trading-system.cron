# Cron schedule for Trading System v2 (operator: ubuntu@VM).
#
# CANONICAL — generated to match config/cron_registry.yaml (the single source of
# truth; TASK #3 Cron Officer). Install via `crontab deploy/cron/trading-system.cron`
# then verify `crontab -l`. Update the registry first, then regenerate this file.
#
# System timezone is Asia/Kolkata (IST, +0530) — all times below are IST.
# Every Python entry sources .env so TELEGRAM_BOT_TOKEN / GEMINI_API_KEY / etc.
# are available in the cron shell.
#
# FIX-189 (2026-06-19): cron MUST run these under bash, not dash. cron's default
# /bin/sh is dash, whose `.` (source) builtin will NOT load a relative path with
# no slash -> `. .env` fails with "sh: .: .env: not found" and EVERY job dies
# before Python runs (no token refresh, no heartbeats, no per-cron logs). Two
# independent guards below:
#   (1) SHELL=/bin/bash  -> forces bash for all crontab commands;
#   (2) `. ./.env`       -> the `./` slash makes even dash source from CWD.
# Belt-and-suspenders: either alone fixes it; both together is defence-in-depth.
#
# Last synced with registry: 2026-06-19  (FIX-189 dash fix: SHELL=/bin/bash +
# `. ./.env`; auto_refresh_token -> 08:15; +cron_officer briefing/eod; +analytics
# .db backup; +db_retention; backup-retention covers analytics; +TASK #5
# system_manager_eod 18:45).

# FIX-189: run all jobs under bash (dash's `.` can't source a bare relative path).
SHELL=/bin/bash

# ── 00:00 IST daily | log cleanup (delete *.log >30 days) ───────────────────
0 0 * * * find /home/ubuntu/systems/trading-system/logs -name '*.log' -mtime +30 -delete

# ── 01:00 IST daily | nightly SQLite .backup of the main DB ──────────────────
0 1 * * * sqlite3 /home/ubuntu/systems/trading-system/data_store/trading_system.db ".backup /home/ubuntu/systems/trading-system/data_store/backups/trading_system-$(date +\%Y-\%m-\%d).db" >> /home/ubuntu/systems/trading-system/logs/cron-db-backup.log 2>&1

# ── 01:05 IST daily | nightly .backup of analytics.db (v28 split) ────────────
5 1 * * * sqlite3 /home/ubuntu/systems/trading-system/data_store/analytics.db ".backup /home/ubuntu/systems/trading-system/data_store/backups/analytics-$(date +\%Y-\%m-\%d).db" >> /home/ubuntu/systems/trading-system/logs/cron-db-backup.log 2>&1

# ── 02:00 IST daily | 7-day rolling cleanup of backups (main + analytics) ────
0 2 * * * find /home/ubuntu/systems/trading-system/data_store/backups \( -name "trading_system-*.db" -o -name "analytics-*.db" \) -mtime +7 -delete >> /home/ubuntu/systems/trading-system/logs/cron-db-backup.log 2>&1

# ── 02:30 IST | DB row retention (Mon-Sat prune; Sun prune + VACUUM) ─────────
30 2 * * 1-6 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/db_retention.py >> logs/cron-db-retention.log 2>&1
30 2 * * 0 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/db_retention.py --vacuum >> logs/cron-db-retention.log 2>&1

# ── 04:55 IST daily | Cron Officer morning briefing (TASK #3) ────────────────
55 4 * * * cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/cron_officer.py --briefing >> logs/cron-officer.log 2>&1

# ── 05:00 IST daily | token cleanup (forces fresh zerodha_login) ─────────────
0 5 * * * rm -f /home/ubuntu/systems/trading-system/data_store/session/zerodha_token.json

# ── 08:15 IST Mon-Fri | headless TOTP token refresh (FIX-187) ────────────────
15 8 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/auto_refresh_token.py >> logs/cron-auto-token.log 2>&1

# ── 08:30 IST Mon-Fri | pre-market health check ─────────────────────────────
30 8 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/premarket_healthcheck.py >> logs/premarket-healthcheck.log 2>&1

# ── 08:35 IST Mon-Fri | fetch F&O ban list from NSE ─────────────────────────
35 8 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/fetch_fno_ban.py >> logs/cron-fno-ban.log 2>&1

# ── 08:55 IST Mon-Fri | pre-market Gemini briefing ──────────────────────────
55 8 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/gemini_premarket_brief.py >> logs/cron-premarket-brief.log 2>&1

# ── 09:00 IST Mon-Fri | instrument master refresh ───────────────────────────
0 9 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/refresh_instruments.py --account LFL836 >> logs/cron-refresh-instruments.log 2>&1

# ── Every 5 min 09:00-15:59 Mon-Fri | system metrics capture ────────────────
*/5 9-15 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/capture_metrics_baseline.py >> logs/cron-metrics.log 2>&1

# ── 15:40 IST Mon-Fri | fetch 1-min candle OHLCV for traded symbols ──────────
40 15 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && /home/ubuntu/systems/venv/bin/python scripts/fetch_daily_candles.py >> logs/cron-candle-fetch.log 2>&1

# ── 15:45 IST Mon-Fri | position reconciliation (broker vs system) ──────────
45 15 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/reconcile_positions.py >> logs/cron-reconcile-positions.log 2>&1

# ── 15:50 IST Mon-Fri | EOD cleanup (stale signals, orders, fingerprints) ────
50 15 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/eod_cleanup.py >> logs/cron-eod-cleanup.log 2>&1

# ── 15:55 IST Mon-Fri | EOD verification (positions closed, orders settled) ──
55 15 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/eod_verify.py >> logs/cron-eod-verify.log 2>&1

# ── 16:00 IST Mon-Fri | daily EOD review report (xlsx + md) ─────────────────
0 16 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python reports/daily_review.py >> logs/cron-daily-review.log 2>&1

# ── 16:00 IST Mon-Fri | WAL checkpoint ──────────────────────────────────────
0 16 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && /home/ubuntu/systems/venv/bin/python scripts/wal_checkpoint.py >> logs/wal_checkpoint.log 2>&1

# ── 16:01 IST Mon-Fri | generate screened stocks CSV ─────────────────────────
1 16 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && /home/ubuntu/systems/venv/bin/python scripts/generate_screened_stocks_csv.py >> logs/cron-screened-stocks.log 2>&1

# ── 16:05 IST Mon-Fri | generate daily trading report (excel) ───────────────
5 16 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && /home/ubuntu/systems/venv/bin/python -m reports.daily_report >> logs/daily_report.log 2>&1

# ── 16:10 IST Mon-Fri | trade journal entry ─────────────────────────────────
10 16 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/trade_journal.py >> logs/trade_journal.log 2>&1

# ── 16:15 IST Mon-Fri | strategy metrics (Sharpe, win rate, demotion) ────────
15 16 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/compute_strategy_metrics.py >> logs/cron-strategy-metrics.log 2>&1

# ── 16:16 IST Mon-Fri | system metrics daily summary ─────────────────────────
16 16 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/capture_metrics_baseline.py --summarize >> logs/cron-metrics.log 2>&1

# ── 16:20 IST Mon-Fri | AI log review via Gemini ────────────────────────────
20 16 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/gemini_log_review.py >> logs/cron-gemini-review.log 2>&1

# ── 16:40 IST Mon-Fri | trade quality coaching via Gemini ───────────────────
40 16 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/gemini_trade_coach.py >> logs/cron-trade-coach.log 2>&1

# ── 17:00 IST Mon-Fri | candle data integrity check via Gemini ──────────────
0 17 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/gemini_data_integrity_check.py >> logs/cron-data-integrity.log 2>&1

# ── 18:00 IST Sunday | weekly pattern detection via Gemini ──────────────────
0 18 * * 0 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/gemini_weekly_patterns.py >> logs/cron-weekly-patterns.log 2>&1

# ── 18:00 IST Mon-Fri | cron heartbeat drift monitor (registry-driven) ──────
0 18 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/check_cron_drift.py >> logs/cron-drift-check.log 2>&1

# ── 18:30 IST Mon-Fri | Cron Officer EOD execution summary (TASK #3) ─────────
30 18 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/cron_officer.py --eod-summary >> logs/cron-officer.log 2>&1

# ── 18:45 IST Mon-Fri | System Manager EOD deep cross-check (TASK #5) ────────
45 18 * * 1-5 cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/system_manager.py >> logs/system-manager.log 2>&1

# ── 03:00 IST 1st of month | backup restore drill ───────────────────────────
0 3 1 * * cd /home/ubuntu/systems/trading-system && . ./.env && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/backup_restore_drill.py --quiet >> logs/cron-backup-drill.log 2>&1

# ── Hourly | disk space monitor ─────────────────────────────────────────────
0 * * * * cd /home/ubuntu/systems/trading-system && . ./.env && /home/ubuntu/systems/venv/bin/python scripts/disk_monitor.py >> logs/cron-disk-monitor.log 2>&1
