# Cron schedule for Trading System v2 (operator: ubuntu@VM).
#
# CANONICAL — generated to match config/cron_registry.yaml (the single source of
# truth; TASK #3 Cron Officer). Install via `crontab deploy/cron/trading-system.cron`
# then verify `crontab -l`. Update the registry first, then regenerate this file.
#
# System timezone is Asia/Kolkata (IST, +0530) — all times below are IST.
# Every Python entry sources .env via `set -a && . ./.env && set +a` so
# TELEGRAM_BOT_TOKEN / ZERODHA_API_KEY_LFL836 / GEMINI_BIN / etc. are
# EXPORTED into the child Python process's environment.
#
# FIX-189 (2026-06-19): cron MUST run these under bash, not dash. cron's default
# /bin/sh is dash, whose `.` (source) builtin will NOT load a relative path with
# no slash -> `. .env` fails with "sh: .: .env: not found" and EVERY job dies
# before Python runs (no token refresh, no heartbeats, no per-cron logs). Two
# independent guards below:
#   (1) SHELL=/bin/bash  -> forces bash for all crontab commands;
#   (2) `. ./.env`       -> the `./` slash makes even dash source from CWD.
# Belt-and-suspenders: either alone fixes it; both together is defence-in-depth.
#
# ENV-EXPORT FIX (2026-06-19): `.env` uses bare `VAR=value` (no `export`), so a
# plain `. ./.env` sets SHELL variables that are NOT inherited by the child
# `python` process — every cron job ran WITHOUT its .env secrets (the 15:45
# reconcile_positions "ZERODHA_API_KEY ... must be set" + "Telegram env not set"
# were both this). FIX-189 made jobs RUN; they still got no secrets. Wrapping the
# source in `set -a` (allexport) ... `set +a` exports everything defined while
# sourcing, so os.environ in Python sees them. Verified empirically on the VM.
#
# Last synced with registry: 2026-06-19  (env-export fix: set -a/+a around
# `. ./.env`; reconcile_positions --account LFL836; FIX-189 dash fix:
# SHELL=/bin/bash + `. ./.env`; auto_refresh_token -> 08:15; +cron_officer
# briefing/eod; +analytics.db backup; +db_retention; backup-retention covers
# analytics; +TASK #5 system_manager_eod 18:45).

# FIX-189: run all jobs under bash (dash's `.` can't source a bare relative path).
SHELL=/bin/bash

# Phase 2.3 (Cron Officer): jobs that cannot emit a DB heartbeat (shell jobs +
# unmonitored python) append an exit-code MARKER the Officer reads at EOD:
#   ; rc=$?; mkdir -p <marks>; echo "$rc $(date -Iseconds)" > <marks>/<name>.done
# `rc=$?` captures the JOB's real exit BEFORE the marker write, and the marker
# write sits after `;` so it can never affect the job. A missing/stale marker is
# reported "No signal" (informational) — never a false CRITICAL. Marker name ==
# the registry job key so the Officer matches it.

# ── 00:00 IST daily | log cleanup (delete *.log >30 days) ───────────────────
0 0 * * * find /home/ubuntu/systems/trading-system/logs -name '*.log' -mtime +30 -delete; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/log_cleanup.done

# ── 01:00 IST daily | nightly SQLite .backup of the main DB ──────────────────
0 1 * * * sqlite3 /home/ubuntu/systems/trading-system/data_store/trading_system.db ".backup /home/ubuntu/systems/trading-system/data_store/backups/trading_system-$(date +\%Y-\%m-\%d).db" >> /home/ubuntu/systems/trading-system/logs/cron-db-backup.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/db_backup.done

# ── 01:05 IST daily | nightly .backup of analytics.db (v28 split) ────────────
5 1 * * * sqlite3 /home/ubuntu/systems/trading-system/data_store/analytics.db ".backup /home/ubuntu/systems/trading-system/data_store/backups/analytics-$(date +\%Y-\%m-\%d).db" >> /home/ubuntu/systems/trading-system/logs/cron-db-backup.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/analytics_backup.done

# ── 02:00 IST daily | 7-day rolling cleanup of backups (main + analytics) ────
0 2 * * * find /home/ubuntu/systems/trading-system/data_store/backups \( -name "trading_system-*.db" -o -name "analytics-*.db" \) -mtime +7 -delete >> /home/ubuntu/systems/trading-system/logs/cron-db-backup.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/backup_retention.done

# ── 02:05 IST daily | sentinel retention (delete DELIVERED alerts >7d; NEVER *.flag) ─
5 2 * * * find /home/ubuntu/systems/trading-system/data_store -maxdepth 1 -name "critical_alert_*.delivered" -mtime +7 -delete >> /home/ubuntu/systems/trading-system/logs/cron-sentinel-retention.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/sentinel_retention.done

# ── 02:30 IST | DB row retention (Mon-Sat prune; Sun prune + VACUUM) ─────────
30 2 * * 1-6 cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/db_retention.py >> logs/cron-db-retention.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/db_retention.done
30 2 * * 0 cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/db_retention.py --vacuum >> logs/cron-db-retention.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/db_retention.done

# ── 09:20 IST daily | Cron Officer morning briefing (post pre-flight; Phase 6) ─
20 9 * * * cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/cron_officer.py --briefing >> logs/cron-officer.log 2>&1

# ── 05:00 IST daily | token cleanup (forces fresh zerodha_login) ─────────────
0 5 * * * rm -f /home/ubuntu/systems/trading-system/data_store/session/zerodha_token.json; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/token_cleanup.done

# ── 08:15 IST Mon-Fri | headless TOTP token refresh (FIX-187) ────────────────
15 8 * * 1-5 cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/auto_refresh_token.py >> logs/cron-auto-token.log 2>&1

# ── 08:30 IST Mon-Fri | Pre-flight Phase A — deep infra checks (subsumes premarket_healthcheck) ─
30 8 * * 1-5 cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python -m scripts.preflight.orchestrator --phase A >> logs/preflight.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/preflight_phase_a.done

# ── 09:14 IST Mon-Fri | Pre-flight Phase B — engine readiness (app up) ─
14 9 * * 1-5 cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python -m scripts.preflight.orchestrator --phase B >> logs/preflight.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/preflight_phase_b.done

# ── 09:15 IST Mon-Fri | Pre-flight Phase C — signal warmup watch (self-terminates ~09:20) ─
15 9 * * 1-5 cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python -m scripts.preflight.orchestrator --phase C --watch-sec 285 >> logs/preflight.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/preflight_phase_c.done

