# Cron schedule for Trading System v2 - GENERATED ARTIFACT. DO NOT HAND-EDIT.
# Source of truth: config/cron_registry.yaml. Regenerate with:
#   python scripts/generate_crontab.py --generate --out deploy/cron/trading-system.cron
# A pre-receive guard rejects a hand-edited canonical; the daily drift-check
# compares the live `crontab -l` against this (bidirectional).
#
# FIX-189: SHELL=/bin/bash forces bash (dash's `.` can't source a bare relative
# path). Python jobs source .env via `set -a && . ./.env && set +a` so secrets
# are EXPORTED into the child process (bare VAR=value otherwise stays shell-local).
# Markers `; rc=$?; ... > cron_marks/<name>.done` let the Cron Officer read shell/
# unmonitored jobs at EOD. All times IST (Asia/Kolkata).

SHELL=/bin/bash

# log_cleanup  [00:00 daily]
0 0 * * * find /home/ubuntu/systems/trading-system/logs -name '*.log' -mtime +30 -delete; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/log_cleanup.done

# db_backup  [01:00 daily]
0 1 * * * sqlite3 /home/ubuntu/systems/trading-system/data_store/trading_system.db ".backup /home/ubuntu/systems/trading-system/data_store/backups/trading_system-$(date +\%Y-\%m-\%d).db" >> /home/ubuntu/systems/trading-system/logs/cron-db-backup.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/db_backup.done

# analytics_backup  [01:05 daily]
5 1 * * * sqlite3 /home/ubuntu/systems/trading-system/data_store/analytics.db ".backup /home/ubuntu/systems/trading-system/data_store/backups/analytics-$(date +\%Y-\%m-\%d).db" >> /home/ubuntu/systems/trading-system/logs/cron-db-backup.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/analytics_backup.done

# backup_retention  [02:00 daily]
0 2 * * * cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/backup_retention.py --apply >> logs/cron-backup-retention.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/backup_retention.done

# sentinel_retention  [02:05 daily]
5 2 * * * find /home/ubuntu/systems/trading-system/data_store -maxdepth 1 -name "critical_alert_*.delivered" -mtime +7 -delete >> /home/ubuntu/systems/trading-system/logs/cron-sentinel-retention.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/sentinel_retention.done

# db_retention  [02:30 daily]
30 2 * * 1-6 cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/db_retention.py >> logs/cron-db-retention.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/db_retention.done

# db_retention_vacuum  [02:30 daily]
30 2 * * 0 cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/db_retention.py --vacuum >> logs/cron-db-retention.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/db_retention.done

# token_cleanup  [05:00 daily]
0 5 * * * rm -f /home/ubuntu/systems/trading-system/data_store/session/zerodha_token.json; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/token_cleanup.done

# cron_officer_briefing  [09:20 daily]
20 9 * * * cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && PYTHONPATH=. /home/ubuntu/systems/venv/bin/python scripts/cron_officer.py --briefing >> logs/cron-officer.log 2>&1

# disk_monitor  [hourly]
0 * * * * cd /home/ubuntu/systems/trading-system && set -a && . ./.env && set +a && /home/ubuntu/systems/venv/bin/python scripts/disk_monitor.py >> logs/cron-disk-monitor.log 2>&1; rc=$?; mkdir -p /home/ubuntu/systems/trading-system/data_store/cron_marks; echo "$rc $(date -Iseconds)" > /home/ubuntu/systems/trading-system/data_store/cron_marks/disk_monitor.done

