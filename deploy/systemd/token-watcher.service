[Unit]
Description=Trading System v2 - Token Watcher (auto-start on fresh token)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=PROJECT_DIR=/home/ubuntu/trading-system
Environment=SLEEP_SEC=30
ExecStart=/bin/bash /home/ubuntu/trading-system/deploy/token_watcher.sh

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=token-watcher

[Install]
WantedBy=multi-user.target
