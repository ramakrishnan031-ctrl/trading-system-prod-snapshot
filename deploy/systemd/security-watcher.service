[Unit]
# VM Security Manager Phase 1 — periodic-oneshot watcher (model: alert-watcher).
# One pass then exit 0; systemd restarts after RestartSec=60 → ~60s cadence.
# Rising NRestarts is NORMAL (it is a heartbeat, not a crash-loop).
Description=VM Security Monitor (trading system) — auth.log + file integrity + alerts
After=network.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/systems/trading-system
EnvironmentFile=/home/ubuntu/systems/trading-system/.env
Environment=PYTHONPATH=/home/ubuntu/systems/trading-system
ExecStart=/home/ubuntu/systems/venv/bin/python scripts/security_monitor.py --watch
# Alert-only watcher; a transient failure must never wedge it.
Restart=always
RestartSec=60

[Install]
WantedBy=multi-user.target
